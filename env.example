# NDMS environment variables — copy this file to .env and fill in real values.
# .env is gitignored; NEVER commit real secrets. See ndms/settings.py for
# how each variable is used and what it falls back to when unset.

# --- Django core ---------------------------------------------------------
# Required. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# True for local dev, False for any real deployment.
DJANGO_DEBUG=True

# Comma-separated hostnames. Only needed when DJANGO_DEBUG=False.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Comma-separated https:// origins that may POST forms to this site.
# Required when DJANGO_DEBUG=False (CSRF will reject requests otherwise).
DJANGO_CSRF_TRUSTED_ORIGINS=

# Optional production-only overrides (safe defaults are used if unset).
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_HSTS_SECONDS=31536000
DJANGO_REMEMBER_ME_SESSION_AGE=2592000
DJANGO_DEFAULT_FROM_EMAIL=NDMS <noreply@ndms.local>

# --- Email (password reset, notifications) --------------------------------
# Leave EMAIL_HOST unset to keep the console backend (emails print to the
# terminal instead of sending) — the safe default for local dev.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# --- Google Maps (Report Incident / Report Detail maps) -------------------
# Maps JavaScript API + Geocoding API + Places API must be enabled and
# billed in Google Cloud Console. See ndms/settings.py for full setup steps.
GOOGLE_MAPS_API_KEY=

# --- Google OAuth ("Continue with Google") --------------------------------
# Separate from the Maps key above — a real OAuth 2.0 / OIDC client.
# See reports/google_oauth.py for the flow.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
