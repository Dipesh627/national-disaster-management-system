# NDMS environment variables. Copy to .env and fill in REAL values locally,
# or set them in the PythonAnywhere WSGI file / Web tab. Never commit .env.

# --- Django core ---
# Required. Must be unique, random, 50+ characters when DJANGO_DEBUG=False.
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourusername.pythonanywhere.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourusername.pythonanywhere.com

# Optional production overrides
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_HSTS_SECONDS=31536000
DJANGO_REMEMBER_ME_SESSION_AGE=2592000
DJANGO_DEFAULT_FROM_EMAIL=NDMS <noreply@example.com>

# --- Email (password reset). Leave EMAIL_HOST empty => console backend (no real mail) ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# --- Google Maps (Maps JavaScript + Geocoding + Places APIs) ---
GOOGLE_MAPS_API_KEY=

# --- Google OAuth ("Continue with Google") ---
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
